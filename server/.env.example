# Copy to .env and adjust. Everything has a working development default.

API_PORT=4000
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000
JWT_SECRET=change-me-to-a-long-random-string

# Leave empty to run an embedded Postgres (no install needed).
# Set to a PostGIS-enabled Postgres in staging/production.
DATABASE_URL=
# EMBEDDED_PG_DIR=C:\Users\you\.medassist-9ja\pgdata
EMBEDDED_PG_PORT=5433

# Password for every seeded demo account (admin@medassist.test, tunde@medassist.test, bello@medassist.test, okafor@medassist.test, ...)
SEED_PASSWORD=MedAssist#2026

# Payments: "mock" (built-in test checkout) or "paystack" (use a sk_test_ key)
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
PLATFORM_FEE_PERCENT=2.5

# SMS: "console" (printed in the server log) or "termii"
SMS_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER_ID=MedAssist

# Address search: "landmarks" (built-in Lagos list) or "nominatim" (OpenStreetMap)
GEOCODER=landmarks

RESERVATION_HOLD_MINUTES=120
BED_REQUEST_TIMEOUT_MINUTES=3
STALE_FLAG_HOURS=24
FRESHNESS_LIMIT_HOURS=72
